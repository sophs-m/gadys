{
  "expo": {
    "name": "gadys2",
    "slug": "gadys2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "gadys2",
    "userInterfaceStyle": "automatic",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#0A172A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Gadys",
      "shortName": "Gadys",
      "backgroundColor": "#0A172A",
      "themeColor": "#0A172A",
      "display": "standalone",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
